DirectoryIndex index.html

RewriteEngine on

# Remove .html extension from requests to individual HTML files
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R]

# Serve .html files when accessed without extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [NC,L]

# Remove trailing slash from directory requests
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# If directory exists, serve index.html without showing it
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*)/?$ $1/index.html [L]